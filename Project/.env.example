# Copy this file to `.env` (same directory) and paste your real connection
# string. `.env` is gitignored; this example file is not.
#
# Neon: Dashboard -> your project -> Connection Details -> copy the
# "Connection string" and paste it below. Keep the ?sslmode=require suffix.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# Alternative to DATABASE_URL: set the parts individually. Only used when
# DATABASE_URL is absent. PGHOST and PGDATABASE are both required for these
# to be picked up.
# PGHOST=ep-xxxx-xxxx.REGION.aws.neon.tech
# PGDATABASE=neondb
# PGUSER=neondb_owner
# PGPASSWORD=
# PGPORT=5432
# PGSSLMODE=require
